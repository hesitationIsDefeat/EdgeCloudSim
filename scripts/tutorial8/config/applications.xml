<?xml version="1.0"?>
<applications>
	<!-- ONAT: Normal-user applications (same as tutorial6). Their usage_percentage values
	     are normalized within this group only - they are selected exclusively for the
	     swept normal-user population, independently from the SAR apps below. -->
	<!-- ONAT: UAV RAM costs, in MB. A UAV admits a task by RAM alone: service_ram is spent once on
	     every UAV that hosts the app's service (no <service_capability> is declared, so every
	     UAV hosts all four apps: 100 + 250 + 1500 + 600 = 2450 MB), queue_ram is held by every
	     task of the app while it is queued or running on the UAV. A task that does not fit in
	     what is left of the UAV's VM RAM (8000 MB, edge_devices.xml) is rejected
	     (REJECTED_DUE_TO_VM_CAPACITY), so with the 5550 MB left after the services a UAV holds up
	     to 555 text messages, 15 photo messages, 10 alerts or 2 map fusions at once (1 running,
	     the rest queued). vm_utilization_on_edge no longer limits the queue - it only tells which
	     UAV is the least loaded and feeds the utilization results. An app has the same values in
	     every tutorial that uses it, since its footprint does not depend on the scenario.
	       TEXT_MESSAGE:               a tiny app - the messaging runtime is 100 MB and a request
	                                   holds ~10 MB (session state and buffers of 20 KB of text).
	       PHOTO_MESSAGE:              the image pipeline (codecs, thumbnailing) is 250 MB and a
	                                   request holds ~350 MB (the decoded 12 MP bitmap of the
	                                   500 KB JPEG plus the resize and filter buffers).
	       DISASTER_MAP_FUSION:        the GIS engine and base map are 1500 MB and a request holds
	                                   ~2000 MB (the fused multi-layer raster of 1.8 MB of
	                                   compressed imagery plus its intermediate layers).
	       SITUATION_AWARENESS_ALERTS: the rule engine and its model are 600 MB and a request
	                                   holds ~550 MB (the window of sensor data it scores). -->
	<application name="TEXT_MESSAGE">
		<service_ram>100</service_ram>
		<queue_ram>10</queue_ram>
		<usage_percentage>70</usage_percentage>
		<prob_cloud_selection>80</prob_cloud_selection>
		<poisson_interarrival>8</poisson_interarrival>
		<delay_sensitivity>0</delay_sensitivity>
		<active_period>30</active_period>
		<idle_period>60</idle_period>
		<data_upload>20</data_upload>
		<data_download>20</data_download>
		<task_length>200</task_length>
		<required_core>1</required_core>
		<vm_utilization_on_edge>2</vm_utilization_on_edge>
		<vm_utilization_on_cloud>0.02</vm_utilization_on_cloud>
		<vm_utilization_on_mobile>0</vm_utilization_on_mobile>
		<!-- ONAT: low urgency - a delayed text message is merely stale, not useless. -->
		<task_timeout>10</task_timeout>
	</application>
	<application name="PHOTO_MESSAGE">
		<service_ram>250</service_ram>
		<queue_ram>350</queue_ram>
		<usage_percentage>30</usage_percentage>
		<prob_cloud_selection>60</prob_cloud_selection>
		<poisson_interarrival>25</poisson_interarrival>
		<delay_sensitivity>0</delay_sensitivity>
		<active_period>20</active_period>
		<idle_period>90</idle_period>
		<data_upload>500</data_upload>
		<data_download>100</data_download>
		<task_length>800</task_length>
		<required_core>1</required_core>
		<vm_utilization_on_edge>6</vm_utilization_on_edge>
		<vm_utilization_on_cloud>0.08</vm_utilization_on_cloud>
		<vm_utilization_on_mobile>0</vm_utilization_on_mobile>
		<!-- ONAT: larger payload than TEXT_MESSAGE, still not urgent - a bit more slack. -->
		<task_timeout>15</task_timeout>
	</application>

	<!-- ONAT: SAR (Search & Rescue) team applications - the original tutorial6 apps.
	     Reserved exclusively for SAR members (see sar_application_names in
	     default_config.properties). Their usage_percentage values are normalized
	     within this group only. -->
	<application name="DISASTER_MAP_FUSION">
		<service_ram>1500</service_ram>
		<queue_ram>2000</queue_ram>
		<usage_percentage>50</usage_percentage>
		<prob_cloud_selection>5</prob_cloud_selection>
		<poisson_interarrival>2</poisson_interarrival>
		<delay_sensitivity>0</delay_sensitivity>
		<active_period>45</active_period>
		<idle_period>15</idle_period>
		<data_upload>1800</data_upload>
		<data_download>200</data_download>
		<task_length>16000</task_length>
		<required_core>1</required_core>
		<vm_utilization_on_edge>35</vm_utilization_on_edge>
		<vm_utilization_on_cloud>0.65</vm_utilization_on_cloud>
		<vm_utilization_on_mobile>0</vm_utilization_on_mobile>
		<!-- ONAT: heaviest task (16000 MI) - map fusion isn't instant, so it gets the most slack. -->
		<task_timeout>20</task_timeout>
	</application>
	<application name="SITUATION_AWARENESS_ALERTS">
		<service_ram>600</service_ram>
		<queue_ram>550</queue_ram>
		<usage_percentage>50</usage_percentage>
		<prob_cloud_selection>5</prob_cloud_selection>
		<poisson_interarrival>6</poisson_interarrival>
		<delay_sensitivity>0</delay_sensitivity>
		<active_period>20</active_period>
		<idle_period>40</idle_period>
		<data_upload>150</data_upload>
		<data_download>400</data_download>
		<task_length>2500</task_length>
		<required_core>1</required_core>
		<vm_utilization_on_edge>10</vm_utilization_on_edge>
		<vm_utilization_on_cloud>0.12</vm_utilization_on_cloud>
		<vm_utilization_on_mobile>0</vm_utilization_on_mobile>
		<!-- ONAT: real-time alerts - the most urgent app here, tightest deadline. -->
		<task_timeout>5</task_timeout>
	</application>
</applications>
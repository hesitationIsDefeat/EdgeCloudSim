<?xml version="1.0"?>
<applications>
	<!-- ONAT: DAG (Directed Acyclic Graph) task - a partitionable task whose sub-tasks
	     are organized into dependent LAYERS instead of one flat, mutually-independent
	     batch. dag_layers is a comma list of how many parallel sub-tasks each layer
	     contains, in dependency order: layer L only starts once every sub-task in
	     layer L-1 has finished (a "simple" DAG - no cross-layer dependencies further
	     back than one layer). Here 1,2,1 means: 1 entry sub-task -> fans out into 2
	     parallel sub-tasks -> 1 final sub-task.
	     partition_count/partitionable are implied by dag_layers (its sum / true) and
	     are not read for a DAG app - see SimSettings.parseApplicationsXML - UNLESS a
	     task_partition_policies entry is "PARTITION_<N>", which overrides this task
	     into a flat N-way split with no layer dependencies at all for that run (see
	     SimSettings.setPartitionCountOverride() and DefaultMobileDeviceManager.submitTask).
	     partition_strategy controls HOW a real layered DAG run ("FULL"/"FULL_LAYERED")
	     divides the task's total length/upload/download among its sub-tasks: "EQUAL"
	     (used by "FULL") gives every sub-task in the whole DAG an identical share
	     regardless of layer; SimSettings.DAG_PARTITION_STRATEGY_LAYER_EQUAL (used by
	     "FULL_LAYERED", via a per-run override - see setTaskPartitionStrategyOverride())
	     instead splits the total equally among LAYERS first, then equally again among
	     each layer's own sub-tasks, so sub-tasks in a smaller layer get a bigger
	     individual share than sub-tasks in a bigger layer.
	     vm_utilization_on_edge (120%, deliberately >100) is sized so a single
	     unpartitioned task (task_partition_policies=NO) can NEVER fit on an edge VM
	     (structurally guaranteed REJECTED_DUE_TO_VM_CAPACITY, same convention as
	     tutorial14's MustPartitionTask), while splitting into several children (FULL,
	     FULL_LAYERED, or any PARTITION_<N>) divides that 120% by the child count and
	     comfortably fits once child count >= 2. NOTE: this percentage is ONLY a
	     declared admission-bookkeeping share (CpuUtilizationModel_Custom) used to
	     decide whether a VM has room to admit a task (immediately execute it, or queue
	     it behind whatever's already running) - it has NO effect on how fast a task
	     actually executes (that's governed purely by cloudlet length / VM mips, see
	     CloudletSchedulerSpaceShared). Consequently the logged/plotted "average VM
	     utilization" is capped at (120 / child count)% even while a VM is genuinely
	     busy 100% of the time - do not read a low reported % here as "VMs are mostly
	     idle"; cross-check against the real busy-time fraction (e.g. instrument
	     CloudletScheduler.runningCloudlets() > 0) before concluding anything about
	     actual saturation. usage_percentage is unrelated to VM capacity - it's only
	     the relative weight used to pick an app among a population's candidates (see
	     SARAwareLoadGenerator.selectTaskType) - moot here since DAG_WORKFLOW is the
	     only normal-user app, so any positive value is selected 100% of the time. -->
	<application name="DAG_WORKFLOW">
		<usage_percentage>100</usage_percentage>
		<dag_layers>1,2,1</dag_layers>
		<partition_strategy>EQUAL</partition_strategy>
		<prob_cloud_selection>5</prob_cloud_selection>
		<poisson_interarrival>100</poisson_interarrival>
		<delay_sensitivity>0</delay_sensitivity>
		<!-- ONAT: idle_period=0 removes the ON/OFF duty-cycle entirely (active windows
		     become back-to-back with no gap) so task arrivals are a single continuous
		     Poisson process at rate 1/poisson_interarrival - matching the standard
		     queueing-theory assumption used for analytical utilization calculations,
		     instead of being throttled by active_period/(active_period+idle_period). -->
		<active_period>45</active_period>
		<idle_period>0</idle_period>
		<data_upload>50</data_upload>
		<data_download>100</data_download>
		<task_length>20000</task_length>
		<required_core>1</required_core>
		<vm_utilization_on_edge>120</vm_utilization_on_edge>
		<vm_utilization_on_cloud>3.6</vm_utilization_on_cloud>
		<vm_utilization_on_mobile>0</vm_utilization_on_mobile>
		<!-- ONAT: deadline for the whole DAG job (not per sub-task/layer) - must stay
		     well BELOW simulation_time (1800s = 30 min, see default_config.properties)
		     or it can never fire within a run at all, leaving a saturated backlog to
		     linger as "uncompleted" (excluded from SimLogger's failed-task percentage)
		     instead of being counted as a TIMED_OUT failure - see PROJECT_STATUS.md §6.9. -->
		<task_timeout>120</task_timeout>
	</application>
</applications>

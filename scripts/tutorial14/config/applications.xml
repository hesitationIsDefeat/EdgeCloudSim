<?xml version="1.0"?>
<applications>
	<!-- ONAT: tutorial14's only application. queue_ram (8400 MB) is deliberately MORE than an
	     edge VM has left (the VM has 8000 MB and the service takes service_ram 1000 MB, so
	     7000 MB), so an unpartitioned task (PARTITION_1) can NEVER be admitted on the edge
	     tier - think of an in-memory reconstruction of the whole search area (imagery, point
	     cloud and feature maps, ~8.4 GB), more than any one UAV can hold. Only partitioning
	     into >=2 pieces (which divides the RAM each piece holds by the partition count, see
	     Task.getQueueRam()) can make it fit: 2 pieces of 4200 MB -> 1 per UAV, 4 of 2100 MB
	     -> 3, 8 of 1050 MB -> 6, 16 of 525 MB -> 13 (1 running, the rest queued). A UAV
	     admits a task by RAM alone (UAVEdgeOrchestrator); vm_utilization_on_edge (120%) no
	     longer admits or rejects anything - it only tells which UAV is the least loaded
	     and feeds the utilization results. partition_count below is a
	     placeholder; MainApp overrides it every run according to the active
	     task_partition_policy (PARTITION_1/PARTITION_2/PARTITION_4 - see
	     SimSettings.setPartitionCountOverride()). -->
	<application name="MustPartitionTask">
		<service_ram>1000</service_ram>
		<queue_ram>8400</queue_ram>
		<usage_percentage>100</usage_percentage>
		<partitionable>true</partitionable>
		<partition_count>4</partition_count>
		<partition_strategy>EQUAL</partition_strategy>
		<prob_cloud_selection>5</prob_cloud_selection>
		<!-- ONAT: each user sends one request every 2 minutes on average. -->
		<poisson_interarrival>120</poisson_interarrival>
		<delay_sensitivity>0</delay_sensitivity>
		<active_period>45</active_period>
		<idle_period>15</idle_period>
		<data_upload>50</data_upload>
		<data_download>100</data_download>
		<task_length>20000</task_length>
		<required_core>1</required_core>
		<vm_utilization_on_edge>120</vm_utilization_on_edge>
		<vm_utilization_on_cloud>3.6</vm_utilization_on_cloud>
		<vm_utilization_on_mobile>0</vm_utilization_on_mobile>
	</application>
</applications>

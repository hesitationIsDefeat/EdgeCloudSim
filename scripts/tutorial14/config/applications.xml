<?xml version="1.0"?>
<applications>
	<!-- ONAT: tutorial14's only application. vm_utilization_on_edge (120%) deliberately
	     EXCEEDS a single edge VM's 100% capacity, so an unpartitioned task (PARTITION_1)
	     can NEVER be admitted on the edge tier - only partitioning into >=2 pieces (which
	     divides the per-child utilization share by partition count, see
	     CpuUtilizationModel_Custom) can make it fit. partition_count below is a
	     placeholder; MainApp overrides it every run according to the active
	     task_partition_policy (PARTITION_1/PARTITION_2/PARTITION_4 - see
	     SimSettings.setPartitionCountOverride()). -->
	<application name="MustPartitionTask">
		<usage_percentage>100</usage_percentage>
		<partitionable>true</partitionable>
		<partition_count>4</partition_count>
		<partition_strategy>EQUAL</partition_strategy>
		<prob_cloud_selection>5</prob_cloud_selection>
		<!-- ONAT: each user sends one request every 2 minutes on average. -->
		<poisson_interarrival>120</poisson_interarrival>
		<delay_sensitivity>0</delay_sensitivity>
		<active_period>45</active_period>
		<idle_period>15</idle_period>
		<data_upload>50</data_upload>
		<data_download>100</data_download>
		<task_length>20000</task_length>
		<required_core>1</required_core>
		<vm_utilization_on_edge>120</vm_utilization_on_edge>
		<vm_utilization_on_cloud>3.6</vm_utilization_on_cloud>
		<vm_utilization_on_mobile>0</vm_utilization_on_mobile>
	</application>
</applications>

<?xml version="1.0"?>
<edge_devices>
    <!-- ONAT: 4 datacenters (one per map quadrant), 4 UAVs each = 16 UAVs total,
         matching tutorial10's layout - spread across the whole map since users move
         with a random walk (no convergence zone) rather than gathering at fixed spots.
         No host declares a service_capability here: which of applications.xml's 4
         SERVICE_APP_* services (see their service_index) each UAV hosts is decided by
         the service placement policy swept via default_config.properties'
         service_placement_policies (see ServicePlacementPolicy), which overrides any
         service_capability tag in this file. UAVs are numbered in the order they appear
         below. A task can be rejected (REJECTED_DUE_TO_VM_CAPACITY) if no UAV hosting
         its service is within SERVICE_RADIUS or every such UAV is already at capacity. -->

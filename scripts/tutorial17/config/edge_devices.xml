        <costPerBw>0.5</costPerBw>
        <costPerSec>15.0</costPerSec>
        <costPerMem>0.2</costPerMem>
        <costPerStorage>0.1</costPerStorage>

        <location>
            <x_pos>250</x_pos>
            <y_pos>250</y_pos>
            <wlan_id>0</wlan_id>
            <attractiveness>0</attractiveness>
        </location>

        <hosts>
            <host>
                <core>8</core>
                <mips>5000</mips>
                <ram>16384</ram>
                <storage>128000</storage>
